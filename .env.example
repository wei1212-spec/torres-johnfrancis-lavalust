# Copy this file to .env and set the values for your environment.
APP_NAME=Lavalust
APP_KEY=generate-a-long-random-value
APP_ENV=development

DB_HOST=your-aiven-host
DB_PORT=your-aiven-port
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL_CA=/etc/secrets/aiven-ca.pem
# Optional fallback for deployments where the secret-file mount is unavailable.
DB_SSL_CA_CONTENT=
# Paste the Aiven CA PEM here when DB_SSL_CA points to no local file.
DB_SSL_VERIFY_SERVER_CERT=true

# Used by migration 004_seed_admin_user when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-running-migrations# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=your-random-application-key
APP_ENV=development

# Database Configuration
DB_HOST=your-aiven-host
DB_PORT=your-aiven-port
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=mydb
DB_SSL_CA=/etc/secrets/aiven-ca.pem
DB_SSL_VERIFY_SERVER_CERT=true



